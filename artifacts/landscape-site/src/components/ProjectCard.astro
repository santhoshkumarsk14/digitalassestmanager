---
interface Props {
  title: string;
  category: string;
  location: string;
  image: string;
  description: string;
}

const { title, category, location, image, description } = Astro.props;
---

<article class="group overflow-hidden rounded-2xl border border-ink/10 bg-white" data-reveal>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={`${title}, ${location}`}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <span class="inline-block rounded-full bg-secondary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-secondary">
      {category}
    </span>
    <h3 class="font-display mt-3 text-xl text-ink">{title}</h3>
    <p class="mt-1 text-sm text-ink/60">{location}</p>
    <p class="mt-3 text-sm leading-6 text-ink/70">{description}</p>
  </div>
</article>
