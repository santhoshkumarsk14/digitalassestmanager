---
import { Phone } from 'lucide-react';
import Layout from '@/layouts/Layout.astro';
import QuoteForm from '@/components/QuoteForm';
import theme from '@/data/theme.json';
---

<Layout
  title="Get a Quote"
  description={`Request a free, no-obligation quote from ${theme.siteName} for your landscape project.`}
>
  <section class="bg-primary text-surface">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-24 md:grid-cols-2 md:items-center">
      <div data-reveal-group>
        <p data-reveal class="font-semibold uppercase tracking-widest text-accent">Get a quote</p>
        <h1 data-reveal class="font-display mt-3 text-4xl leading-tight md:text-5xl">
          Tell us about the site. We'll tell you what it takes.
        </h1>
        <p data-reveal class="mt-6 max-w-md text-surface/85">
          A few quick questions about the project, then we'll come back to you within two working days
          with next steps — usually a site visit.
        </p>
        <a data-reveal href={`tel:${theme.phone.replace(/[^+\d]/g, '')}`} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-surface hover:text-accent">
          <Phone size={16} /> Prefer to talk? Call {theme.phone}
        </a>
      </div>
      <QuoteForm client:load />
    </div>
  </section>
</Layout>
