---
import theme from '@/data/theme.json';

const links = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'Client Feedback', href: '/feedback' },
  { label: 'Get a Quote', href: '/get-quote' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-surface/15 bg-ink text-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl">{theme.siteName}</p>
      <p class="mt-3 max-w-xs text-sm text-surface/70">{theme.tagline}</p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm">
      {links.map((link) => <a href={link.href} class="text-surface/80 transition hover:text-accent">{link.label}</a>)}
    </nav>
    <div class="text-sm text-surface/80">
      <a href={`tel:${theme.phone.replace(/[^+\d]/g, '')}`} class="block hover:text-accent">{theme.phone}</a>
      <a href={`mailto:${theme.email}`} class="mt-2 block hover:text-accent">{theme.email}</a>
      <p class="mt-2">{theme.address}</p>
    </div>
  </div>
  <p class="border-t border-surface/10 px-6 py-6 text-center text-xs text-surface/50">
    &copy; {new Date().getFullYear()} {theme.siteName}. All rights reserved.
  </p>
</footer>
